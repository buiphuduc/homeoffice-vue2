# Sao chép file này thành ".env" rồi điền giá trị thật của bạn.
# Toàn bộ biến môi trường Vue CLI BẮT BUỘC phải bắt đầu bằng "VUE_APP_"

# Link CSV lấy từ Google Sheet: File > Share > Publish to web > chọn CSV
# VUE_APP_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/xxx/pub?output=csv
VUE_APP_SHEET_CSV_URL=/data/products.csv
# Số điện thoại Zalo nhận đơn (chỉ nhập số)
VUE_APP_ZALO_PHONE=0868078988

# Username Messenger/Facebook Page nhận đơn
VUE_APP_MESSENGER_USERNAME=61580520741197

# Số hotline hiển thị (có thể có dấu chấm) và số dùng cho link gọi (chỉ số)
VUE_APP_HOTLINE_DISPLAY=0868.078.988
VUE_APP_HOTLINE_TEL=0868078988

VUE_APP_SHOP_NAME=HTMVN Shop

# Domain thật của site khi lên production (không có dấu / ở cuối) — dùng để
# tạo canonical link + sitemap.xml. Khi chưa có domain thật (đang test data),
# cứ để giá trị mẫu này, chỉ ảnh hưởng SEO chứ không ảnh hưởng chức năng.
VUE_APP_SITE_URL=https://htmvn.com

# URL Web App của Google Apps Script tự dựng cho form Liên hệ (backend tự host,
# không qua dịch vụ ngoài). Deploy theo hướng dẫn trong google-apps-script/Code.gs,
# rồi dán URL dạng https://script.google.com/macros/s/xxxxxxxx/exec vào đây.
# Email nhận tin nhắn cấu hình NGAY TRONG Code.gs (biến TO_EMAIL), không phải ở đây.
VUE_APP_CONTACT_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwbT6IAroCm4WXltJK9zcF1bempPIz1keUBR3Ja2bkfBOlv1S17Ulm2fRrOWLnGKHsY/exec

